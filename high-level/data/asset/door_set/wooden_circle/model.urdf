<robot name="frameless_paired_louver_door">
  <material name="honey_oak">
    <color rgba="0.66 0.39 0.17 1" />
  </material>
  <material name="sunlit_oak">
    <color rgba="0.76 0.49 0.24 1" />
  </material>
  <material name="oak_shadow">
    <color rgba="0.43 0.24 0.1 1" />
  </material>
  <material name="aged_steel">
    <color rgba="0.33 0.34 0.32 1" />
  </material>
  <material name="warm_brass">
    <color rgba="0.76 0.57 0.19 1" />
  </material>
  <material name="polished_brass">
    <color rgba="0.93 0.76 0.34 1" />
  </material>
  <link name="kinematic_root" />
  <link name="door_0">
    <visual name="door_0">
      <geometry>
        <mesh filename="assets/meshes/door_0.obj" />
      </geometry>
    </visual>
    <collision name="door_0">
      <geometry>
        <mesh filename="assets/meshes/door_0.obj" />
      </geometry>
    </collision>
  </link>
  <link name="knob_mount_0">
    </link>
  <link name="knob_0">
    <visual name="knob_0">
      <geometry>
        <mesh filename="assets/meshes/knob_0.obj" />
      </geometry>
    </visual>
    <collision name="knob_0">
      <geometry>
        <mesh filename="assets/meshes/knob_0.obj" />
      </geometry>
    </collision>
  </link>
  <link name="door_1">
    <visual name="door_1">
      <geometry>
        <mesh filename="assets/meshes/door_1.obj" />
      </geometry>
    </visual>
    <collision name="door_1">
      <geometry>
        <mesh filename="assets/meshes/door_1.obj" />
      </geometry>
    </collision>
  </link>
  <link name="knob_mount_1">
    </link>
  <link name="knob_1">
    <visual name="knob_1">
      <geometry>
        <mesh filename="assets/meshes/knob_1.obj" />
      </geometry>
    </visual>
    <collision name="knob_1">
      <geometry>
        <mesh filename="assets/meshes/knob_1.obj" />
      </geometry>
    </collision>
  </link>
  <joint name="root_to_door_0" type="revolute">
    <origin xyz="-0.497599 0 0" rpy="0 0 0" />
    <parent link="kinematic_root" />
    <child link="door_0" />
    <axis xyz="0 0 -1" />
    <limit effort="40" velocity="1" lower="0" upper="1.74533" />
  </joint>
  <joint name="door_0_to_knob_mount_0" type="fixed">
    <origin xyz="0.461599 -0.02 0.318" rpy="0 0 0" />
    <parent link="door_0" />
    <child link="knob_mount_0" />
  </joint>
  <joint name="knob_mount_0_to_knob_0" type="revolute">
    <origin xyz="0 -0.014 0" rpy="0 0 0" />
    <parent link="knob_mount_0" />
    <child link="knob_0" />
    <axis xyz="0 -1 0" />
    <limit effort="3" velocity="3" lower="0" upper="1.309" />
  </joint>
  <joint name="root_to_door_1" type="revolute">
    <origin xyz="0.497599 0 0" rpy="0 0 0" />
    <parent link="kinematic_root" />
    <child link="door_1" />
    <axis xyz="0 0 1" />
    <limit effort="40" velocity="1" lower="0" upper="1.74533" />
  </joint>
  <joint name="door_1_to_knob_mount_1" type="fixed">
    <origin xyz="-0.461599 -0.02 0.318" rpy="0 0 0" />
    <parent link="door_1" />
    <child link="knob_mount_1" />
  </joint>
  <joint name="knob_mount_1_to_knob_1" type="revolute">
    <origin xyz="0 -0.014 0" rpy="0 0 0" />
    <parent link="knob_mount_1" />
    <child link="knob_1" />
    <axis xyz="0 1 0" />
    <limit effort="3" velocity="3" lower="0" upper="1.309" />
  </joint>
</robot>
